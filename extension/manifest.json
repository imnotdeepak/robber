{
  "manifest_version": 3,
  "name": "Robber Advisor",
  "version": "0.1.0",
  "description": "Shows the Robber advisor (running on this computer) in the side panel.",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open the Robber advisor" }
}
